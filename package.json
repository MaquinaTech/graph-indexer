{
    "name": "graph-indexer",
    "version": "3.1.0",
    "description": "Live code graph and search for AI coding agents over MCP: tree-sitter (WASM) symbols, scope/import/type-aware references, call graphs, change impact and hybrid search — local, zero-dependency, no native builds.",
    "type": "module",
    "main": "src/query/intel.mjs",
    "exports": {
        ".": "./src/query/intel.mjs",
        "./mcp": "./src/mcp/server.mjs"
    },
    "bin": {
        "graph-indexer": "bin/graph-indexer.mjs",
        "idx-mcp": "bin/graph-indexer.mjs",
        "idx-index": "bin/graph-indexer.mjs"
    },
    "files": [
        "bin/",
        "src/",
        "vendor/",
        "README.md",
        "CHANGELOG.md",
        "SECURITY.md",
        "TRADEMARK.md",
        "LICENSE"
    ],
    "scripts": {
        "test": "node --test test/*.test.mjs",
        "bench": "node bench/eval-search.mjs",
        "bench:graph": "node bench/eval-graph.mjs",
        "bench:localize": "node bench/eval-localize.mjs",
        "fixtures": "node bench/fixtures.mjs",
        "start": "node bin/graph-indexer.mjs serve",
        "index": "node bin/graph-indexer.mjs index"
    },
    "engines": {
        "node": ">=22.5.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/MaquinaTech/graph-indexer.git"
    },
    "keywords": [
        "mcp",
        "model-context-protocol",
        "code-search",
        "call-graph",
        "tree-sitter",
        "code-intelligence",
        "ai-agents",
        "claude-code",
        "find-references",
        "impact-analysis"
    ],
    "author": {
        "name": "MaquinaTech",
        "url": "https://github.com/MaquinaTech",
        "email": "nicolopezdelerma@gmail.com"
    },
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/MaquinaTech/graph-indexer/issues"
    },
    "homepage": "https://github.com/MaquinaTech/graph-indexer",
    "publishConfig": {
        "access": "public"
    }
}
